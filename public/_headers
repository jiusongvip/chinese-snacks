# Hashed Astro assets: safe for immutable year-long cache
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Images change rarely; 30 days without immutable to allow refresh on replace
/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# Self-hosted fonts: immutable year-long cache
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

