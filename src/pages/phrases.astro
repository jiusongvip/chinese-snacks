---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import PhraseSheet from "../components/PhraseSheet.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout title="Chinese Food Ordering Phrases | ChineseSnacks" description="Essential Mandarin phrases for ordering street food in China. Pinyin, pronunciation, and English translations included.">
  <Nav />
  <div class="min-h-[10dvh] pt-24">
    <div class="max-w-[1400px] mx-auto w-full pt-16 px-6">
      <p class="text-sm font-medium tracking-wide uppercase text-accent mb-3">Language</p>
      <h1 class="text-4xl md:text-6xl font-black tracking-tighter mb-4">Order With Confidence</h1>
      <p class="text-lg text-ink-muted max-w-[55ch] mb-2">Five phrases is all you need to navigate any snack stall in China.</p>
    </div>
  </div>
  <PhraseSheet />
  <Footer />
</BaseLayout>
