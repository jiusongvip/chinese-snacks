---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import CityGuide from "../../components/CityGuide.astro";
import cities from "../../data/cities.json";
import snacks from "../../data/snacks.json";
import streets from "../../data/snack-streets.json";

const city = cities.find(c => c.id === "chengdu")!;
const citySnacks = snacks.filter(s => s.bestCities.includes("chengdu"));
const cityStreets = streets.filter(s => s.cityId === "chengdu");
---

<BaseLayout title="Chengdu Snacks Guide | ChineseSnacks" description={city.seoDescription}>
  <Nav />
  <CityGuide city={city} citySnacks={citySnacks} cityStreets={cityStreets} />
  <Footer />
</BaseLayout>
