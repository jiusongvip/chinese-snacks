---
interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalURL?: string;
  schemaType?: string;
  noindex?: boolean;
}

const { title, description, ogImage = "/images/hero.webp", canonicalURL, schemaType, noindex = false } = Astro.props;
const siteUrl = Astro.site?.origin || "https://chinese-snacks.com";
const pageUrl = canonicalURL ? `${siteUrl}${canonicalURL}` : new URL(Astro.url.pathname || '/', siteUrl).href.replace(/\/$/, '');
const siteName = "ChineseSnacks";
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-S9C2H9ZQJD"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-S9C2H9ZQJD');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {!noindex && <link rel="canonical" href={pageUrl} />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage.startsWith("http") ? ogImage : `${siteUrl}${ogImage}`} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.startsWith("http") ? ogImage : `${siteUrl}${ogImage}`} />

    <!-- Schema.org -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": schemaType || "WebPage",
      "name": title,
      "description": description,
      "url": pageUrl
    })}>
    </script>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": siteName,
      "url": siteUrl,
      "description": "Independent editorial team publishing practical Chinese street food guides with prices, ordering phrases, and recommendations built from market data and local community feedback."
    })}>
    </script>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": siteName,
      "url": siteUrl,
      "description": "Independent editorial team publishing practical Chinese street food guides with prices, ordering phrases, and recommendations built from market data and local community feedback.",
      "potentialAction": {
        "@type": "SearchAction",
        "target": `${siteUrl}/snacks?q={search_term_string}`,
        "query-input": "required name=search_term_string"
      }
    })}>
    </script>
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700,900&display=swap" />
  </head>
  <body class="bg-surface text-ink antialiased">
    <slot />
  </body>
</html>
