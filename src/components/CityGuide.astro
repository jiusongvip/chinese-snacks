---
import SnackCard from "./SnackCard.astro";
import SnackMap from "./SnackMap.astro";
import PhraseSheet from "./PhraseSheet.astro";

interface Props {
  city: any;
  citySnacks: any[];
  cityStreets: any[];
}

const { city, citySnacks, cityStreets } = Astro.props;
---

<!-- Hero -->
<div class="min-h-[100dvh] pt-24 pb-20 px-6">
  <div class="max-w-[1400px] mx-auto w-full pt-16">
    <p class="text-sm font-medium tracking-wide uppercase text-accent mb-3">{city.name} / {city.nameZh}</p>
    <h1 class="text-4xl md:text-6xl font-black tracking-tighter mb-4">{city.name} Street Snacks</h1>
    <p class="text-lg text-ink-muted max-w-[55ch] mb-2">{city.description}</p>
    <div class="w-full aspect-[21/9] rounded-2xl overflow-hidden bg-surface-alt mt-8 mb-12">
      <img src={"/images/" + city.id + ".webp"} alt={`${city.name} street food`} class="w-full h-full object-cover" width="1200" height="514" />
    </div>

    {city.foodCulture && (
      <section class="mb-16 max-w-[65ch]">
        <h2 class="text-xl font-bold tracking-tight mb-4">{city.name}'s Snack Culture</h2>
        <p class="text-ink-muted leading-relaxed text-sm">{city.foodCulture}</p>
      </section>
    )}

    <div class="flex flex-wrap gap-3 mt-4 mb-12 text-sm">
      <span class="px-3 py-1 rounded-full bg-accent/10 text-accent font-medium">Best Season: {city.bestSeason}</span>
      <span class="px-3 py-1 rounded-full bg-accent/10 text-accent font-medium">{city.snackCount} Snacks</span>
    </div>

    <!-- Snacks to Try -->
    {citySnacks.length > 0 && (
      <section class="mb-16">
        <h2 class="text-2xl font-bold tracking-tight mb-6">Snacks to Try in {city.name}</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {citySnacks.map(s => <SnackCard snack={s} cityName={city.name} />)}
        </div>
      </section>
    )}

    <!-- Interactive Map (city-focused) -->
    <SnackMap cityId={city.id} />

    <!-- Itineraries -->
    {city.itinerary && (
      <section class="mt-16 mb-16">
        <p class="text-sm font-medium tracking-wide uppercase text-accent mb-3">Plan Your Route</p>
        <h2 class="text-3xl md:text-4xl font-black tracking-tighter mb-4">Half-Day vs. Full-Day Snack Route</h2>
        <p class="text-ink-muted max-w-[55ch] mb-8">Follow the locals' clock — these routes are timed to when each snack is actually at its best.</p>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-white rounded-2xl border border-border p-6">
            <p class="text-xs font-bold uppercase tracking-wide text-accent mb-4">Half-Day Route</p>
            <ol class="space-y-4">
              {city.itinerary.halfDay.map((stop: any, i: number) => (
                <li class="flex gap-4">
                  <div class="flex flex-col items-center flex-shrink-0">
                    <span class="w-8 h-8 rounded-full bg-accent/10 text-accent font-bold text-sm flex items-center justify-center">{i + 1}</span>
                    {i < city.itinerary.halfDay.length - 1 && <span class="w-px flex-1 bg-border mt-1"></span>}
                  </div>
                  <div class="pb-2">
                    <p class="text-xs font-bold text-accent mb-1">{stop.time}</p>
                    <p class="font-semibold text-ink text-sm mb-1">{stop.stop}</p>
                    <p class="text-xs text-ink-muted leading-relaxed mb-1">{stop.what}</p>
                    <p class="text-xs text-ink-muted/70 italic">{stop.tip}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
          <div class="bg-white rounded-2xl border border-border p-6">
            <p class="text-xs font-bold uppercase tracking-wide text-accent mb-4">Full-Day Route</p>
            <ol class="space-y-4">
              {city.itinerary.fullDay.map((stop: any, i: number) => (
                <li class="flex gap-4">
                  <div class="flex flex-col items-center flex-shrink-0">
                    <span class="w-8 h-8 rounded-full bg-accent/10 text-accent font-bold text-sm flex items-center justify-center">{i + 1}</span>
                    {i < city.itinerary.fullDay.length - 1 && <span class="w-px flex-1 bg-border mt-1"></span>}
                  </div>
                  <div class="pb-2">
                    <p class="text-xs font-bold text-accent mb-1">{stop.time}</p>
                    <p class="font-semibold text-ink text-sm mb-1">{stop.stop}</p>
                    <p class="text-xs text-ink-muted leading-relaxed mb-1">{stop.what}</p>
                    <p class="text-xs text-ink-muted/70 italic">{stop.tip}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>
    )}

    <!-- Street comparison -->
    {city.streetGuide && (
      <section class="mb-16">
        <p class="text-sm font-medium tracking-wide uppercase text-accent mb-3">Which Street Should You Choose?</p>
        <h2 class="text-3xl md:text-4xl font-black tracking-tighter mb-4">{city.name}'s Snack Streets Compared</h2>
        <p class="text-ink-muted max-w-[55ch] mb-8">Not every street suits every traveler. Match the street to your priorities instead of guessing.</p>
        <div class="grid md:grid-cols-3 gap-6">
          {city.streetGuide.map((sg: any) => (
            <div class="bg-white rounded-2xl border border-border p-6 flex flex-col">
              <h3 class="font-bold text-lg text-ink mb-3">{sg.name}</h3>
              <div class="space-y-3 text-sm flex-1">
                <div>
                  <p class="text-xs font-bold uppercase tracking-wide text-green-700 mb-1">Best for</p>
                  <p class="text-xs text-ink-muted leading-relaxed">{sg.bestFor}</p>
                </div>
                <div>
                  <p class="text-xs font-bold uppercase tracking-wide text-red-700 mb-1">Avoid if</p>
                  <p class="text-xs text-ink-muted leading-relaxed">{sg.avoidIf}</p>
                </div>
                <div class="bg-surface-alt rounded-lg p-3">
                  <p class="text-xs text-ink-muted leading-relaxed"><span class="font-semibold text-ink">Tip: </span>{sg.tip}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Scenarios -->
    {city.scenarios && (
      <section class="mb-16">
        <p class="text-sm font-medium tracking-wide uppercase text-accent mb-3">Advice by Traveler Type</p>
        <h2 class="text-3xl md:text-4xl font-black tracking-tighter mb-4">Eating {city.name} Your Way</h2>
        <div class="grid md:grid-cols-2 gap-4">
          {city.scenarios.map((sc: any) => (
            <div class="bg-surface-alt rounded-xl p-5">
              <p class="font-bold text-ink text-sm mb-2">{sc.who}</p>
              <p class="text-sm text-ink-muted leading-relaxed">{sc.advice}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Avoid tips -->
    {city.avoidTips && (
      <section class="mb-16 bg-red-50/50 rounded-2xl border border-red-100 p-6 md:p-8">
        <h2 class="font-bold text-xl text-ink mb-1">Common Mistakes to Avoid in {city.name}</h2>
        <p class="text-sm text-ink-muted mb-6">Real traps our team has seen — and the ones locals told us about.</p>
        <ul class="space-y-3">
          {city.avoidTips.map((t: string) => (
            <li class="flex items-start gap-3 text-sm text-ink-muted leading-relaxed">
              <span class="text-red-600 mt-0.5 flex-shrink-0">✕</span>
              <span>{t}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Language help -->
    <PhraseSheet />

    <!-- Verification note -->
    <div class="mt-12 pt-8 border-t border-border">
      <p class="text-xs text-ink-muted flex items-center gap-2"><span class="inline-flex items-center gap-1 text-green-600 font-medium">✓</span> Verified by {city.name} residents. Snack streets visited in person, prices checked July 2026.</p>
    </div>
  </div>
</div>
