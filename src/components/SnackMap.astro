---
import streets from "../data/snack-streets.json";
import cities from "../data/cities.json";
import snacks from "../data/snacks.json";

const { cityId } = Astro.props;

const cityMap = Object.fromEntries(cities.map(c => [c.id, c]));
const snackMap = Object.fromEntries(snacks.map(s => [s.id, s]));
const focusCity = cityId ? cityMap[cityId] : null;
const visibleStreets = focusCity ? streets.filter(s => s.cityId === cityId) : streets;

const sectionTitle = focusCity ? `${focusCity.name}'s Snack Streets` : "China's Snack Streets";
const sectionDesc = focusCity
  ? `Tap a marker to see what to eat, when to go, and how tourist-friendly each street is — then follow the routes below.`
  : "Tap a marker to see what to eat, when to go, and how tourist-friendly each street is.";
---

<section class="py-16 px-6 bg-surface-alt">
  <div class="max-w-[1400px] mx-auto w-full">
    <p class="text-sm font-medium tracking-wide uppercase text-accent-dark mb-3">Interactive Map</p>
    <h2 class="text-3xl md:text-4xl font-black tracking-tighter mb-4">{sectionTitle}</h2>
    <p class="text-ink-muted max-w-[55ch] mb-8">{sectionDesc}</p>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <div class="lg:col-span-2 bg-white rounded-2xl border border-border overflow-hidden" style="min-height:500px;">
        <div id="snack-map" class="w-full h-full" style="min-height:500px;"></div>
      </div>
      <div class="space-y-3 max-h-[500px] overflow-y-auto">
        {visibleStreets.map(st => (
          <div class="bg-white rounded-xl border border-border p-4 hover:border-accent/60 transition-all cursor-pointer snack-street-card" data-street-id={st.id}>
            <div class="flex items-center gap-3 mb-2">
              <img src={"/images/" + st.cityId + ".png"} alt={cityMap[st.cityId]?.name} class="w-8 h-8 rounded-lg object-cover flex-shrink-0" />
              <div>
                <h3 class="font-bold text-sm text-ink">{st.name}</h3>
                <p class="text-xs text-ink-muted">{cityMap[st.cityId]?.name} &middot; {st.nameZh}</p>
              </div>
            </div>
            <p class="text-xs text-ink-muted leading-relaxed mb-2">{st.description}</p>
            <div class="flex flex-wrap gap-2 text-xs">
              <span class="px-2 py-1 rounded-full bg-surface-alt text-ink-muted">{st.bestTime}</span>
              <span class="px-2 py-1 rounded-full bg-surface-alt text-ink-muted">{"★".repeat(st.touristFriendly)}{"☆".repeat(5-st.touristFriendly)}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script define:vars={{ streetsData: visibleStreets, cityMapData: cityMap, focus: focusCity ? { lat: focusCity.lat, lng: focusCity.lng, zoom: 13 } : { lat: 33.5, lng: 108.5, zoom: 5 } }}>
  function initMap(){
    if(typeof L==="undefined"){setTimeout(initMap,100);return;}
    var map=L.map("snack-map").setView([focus.lat,focus.lng],focus.zoom);
    L.tileLayer("https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png",{attribution:"&copy; OSM",maxZoom:18}).addTo(map);
    var markers={};
    streetsData.forEach(function(st){
      var city=cityMapData[st.cityId]||{};
      var stars="";
      for(var i=0;i<st.touristFriendly;i++)stars+="★";
      for(var i=st.touristFriendly;i<5;i++)stars+="☆";
      var popup="<div style='min-width:200px;'><strong>"+st.name+"</strong><br><small>"+(city.name||st.cityId)+" &middot; "+st.nameZh+"</small><br><p style='margin:6px 0;font-size:12px;'>"+st.description+"</p><small>Best time: "+st.bestTime+"<br>"+stars+"</small><br><a href='/cities/"+st.cityId+"/' style='color:#c34a36;'>View city guide &rarr;</a></div>";
      markers[st.id]=L.marker([st.lat,st.lng]).bindPopup(popup).addTo(map);
    });
    document.querySelectorAll(".snack-street-card").forEach(function(card){
      card.addEventListener("mouseenter",function(){var sid=this.getAttribute("data-street-id");if(markers[sid])markers[sid].openPopup();});
      card.addEventListener("click",function(){var sid=this.getAttribute("data-street-id");if(markers[sid]){map.setView([markers[sid].getLatLng().lat,markers[sid].getLatLng().lng],14);markers[sid].openPopup();}});
    });
    setTimeout(function(){map.invalidateSize();},500);
  }
  if(document.readyState==="loading"){document.addEventListener("DOMContentLoaded",initMap);}else{initMap();}
</script>
