---
interface Props {
  snack: {
    id: string;
    nameEn: string;
    nameZh: string;
    namePinyin: string;
    brand: string;
    brandZh: string;
    description: string;
    taste: string;
    priceRmbMin: number;
    priceRmbMax: number;
    priceOnline: string;
    whereToBuy: string[];
    tags: string[];
    isVegetarian: boolean;
    isSpicy: boolean;
    rating: number;
    editorPick: boolean;
    travelFriendly: boolean;
  };
}

const { snack } = Astro.props;

const buyLabels: Record<string, string> = {
  supermarket: "Supermarket",
  convenience: "Convenience store",
  online: "Buy online",
  "street-fresh": "Street-fresh",
  "supermarket-fresh": "Fresh at supermarket",
  bakery: "Bakery",
  "asian-grocery": "Asian grocer",
  gift: "Gift shop",
  beijing: "Beijing",
};

function stars(rating: number): string {
  const full = "★".repeat(Math.round(rating));
  const empty = "☆".repeat(5 - Math.round(rating));
  return full + empty;
}
---

<div class="bg-white rounded-xl border border-border p-5 hover:border-accent/60 hover:shadow-sm transition-all flex flex-col">
  <div class="flex items-start justify-between gap-2 mb-2">
    <h3 class="font-bold text-sm text-ink leading-snug">{snack.nameEn}</h3>
    <div class="flex gap-1 flex-shrink-0">
      {snack.editorPick && (
        <span class="text-[10px] px-2 py-0.5 rounded-full bg-accent/25 text-accent-dark font-bold">EDITOR'S PICK</span>
      )}
    </div>
  </div>
  <p class="text-xs text-ink-muted mb-1">
    <span class="font-medium text-ink">{snack.nameZh}</span> &middot; {snack.namePinyin}
  </p>
  <p class="text-[11px] text-ink-muted mb-2">
    <span class="font-semibold text-ink/70">Brand:</span> {snack.brand} <span class="text-ink/40">({snack.brandZh})</span>
  </p>
  <p class="text-xs text-ink-muted leading-relaxed mb-3 flex-1">{snack.description}</p>

  <div class="flex items-center gap-2 mb-3">
    <span class="text-sm text-amber-500 tracking-tight" aria-label={`Rating ${snack.rating} out of 5`}>{stars(snack.rating)}</span>
    <span class="text-[10px] text-ink-muted">({snack.rating}.0)</span>
  </div>

  <div class="flex flex-wrap gap-1 mb-3">
    <span class="text-[10px] px-2 py-0.5 rounded-full bg-surface-alt border border-border text-ink-muted">&yen;{snack.priceRmbMin}&ndash;{snack.priceRmbMax}</span>
    {snack.isVegetarian && <span class="text-[10px] px-2 py-0.5 rounded-full bg-green-100 text-green-700 font-medium">Vegan</span>}
    {snack.isSpicy && <span class="text-[10px] px-2 py-0.5 rounded-full bg-red-100 text-red-700 font-medium">Spicy</span>}
    {snack.travelFriendly && <span class="text-[10px] px-2 py-0.5 rounded-full bg-blue-100 text-blue-700 font-medium">Bring-home safe</span>}
  </div>

  <p class="text-[11px] text-ink-muted mb-1"><span class="font-semibold text-ink/70">Buy:</span> {snack.whereToBuy.map(b => buyLabels[b] || b).join(" / ")}</p>
  <p class="text-[11px] text-ink-muted">{snack.priceOnline}</p>
</div>
