---
import streets from "../data/snack-streets.json";
import cities from "../data/cities.json";

const cityMap = Object.fromEntries(cities.map(c => [c.id, c]));
const markersStr = JSON.stringify(streets.map(s => ({
  lat: s.lat, lng: s.lng, name: s.name, city: cityMap[s.cityId]?.name || "?"
})));
---

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<div id="snackmap" class="w-full h-[500px] rounded-xl overflow-hidden border border-border"></div>

<script is:inline>
  (function initMap() {
    if (document.getElementById('snackmap')?.dataset.loaded) return;
    if (!window.L) { setTimeout(initMap, 200); return; }
    document.getElementById('snackmap').dataset.loaded = '1';
    const map = L.map('snackmap').setView([34.0, 108.0], 5);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 18, attribution: '&copy; OSM' }).addTo(map);
    const icon = L.icon({ iconUrl: 'data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2228%22 height=%2240%22><circle cx=%2214%22 cy=%2214%22 r=%2212%22 fill=%22%23C34A36%22/><polygon points=%2214,40 5,22 23,22%22 fill=%22%23C34A36%22/><circle cx=%2214%22 cy=%2214%22 r=%226%22 fill=%22white%22/></svg>', iconSize: [28,40], iconAnchor: [14,40], popupAnchor: [0,-40] });
    JSON.parse('').forEach(m => { L.marker([m.lat, m.lng], { icon }).addTo(map).bindPopup('<strong></strong><br/>') });
  })();
</script>
